rules_version = '2';

// These rules are what actually protect your data. The API key in
// js/config.js is public by design and protects nothing.
//
// As written: anyone who opens the site can read and write the board, because
// the app signs every visitor in anonymously. That matches "anyone with the
// link can use it" — fine for a club board, not fine for anything sensitive.
//
// To lock it down to specific people, see the "Restricting access" section of
// README.md, then replace the condition below with the allowlist version.

service cloud.firestore {
  match /databases/{database}/documents {

    match /boards/{boardId} {
      allow read, write: if request.auth != null;

      match /tasks/{taskId} {
        allow read, write: if request.auth != null;
      }
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
